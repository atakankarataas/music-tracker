# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database -----------------------------------------------------------
# Writer connection used by the Python ingestion and by ingest/migrate.py.
DB_URI=postgresql://postgres:password@host:5432/postgres
# Read-only role used by the Next.js web tier. Generate with
# `python3 ingest/provision_web_reader.py`. In development the app falls back
# to DB_URI when this is unset; in production it is required.
WEB_DB_URI=postgresql://music_web_reader:password@host:6543/postgres

# --- Private site access -------------------------------------------------
# The web app signs a cookie with SITE_PASSWORD and fails closed on Vercel when
# it is missing. Use a long random value.
SITE_PASSWORD=
SITE_USERNAME=listener

# --- Spotify application -------------------------------------------------
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIPY_CACHE_PATH=.cache
# Refresh token used by the read-only audit helper (ingest/audit.py).
SPOTIFY_REFRESH_TOKEN=
# Only needed for the optional in-app playlist export. Must exactly match a
# redirect URI registered on the Spotify application.
SPOTIFY_WEB_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# --- Tracker tuning (optional; defaults shown) ---------------------------
SPOTIFY_SYNC_LOOKBACK_DAYS=7
SPOTIFY_SYNC_MAX_PAGES=20
SPOTIFY_SYNC_OVERLAP_PAGES=2
SPOTIFY_SYNC_FORCE_RECOVERY=false

# --- Metadata enrichment (optional; defaults shown) ----------------------
METADATA_BACKFILL_LIMIT=200
METADATA_TIME_BUDGET_SECONDS=240
# Set to 1 to reuse metadata already in the database without calling Spotify.
METADATA_LOCAL_ONLY=0

# GitHub Actions also provides SPOTIPY_CACHE: the serialised spotipy token
# cache, stored as a repository secret rather than in this file.
